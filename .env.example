# PostgreSQL connection string (user:pass@host:port/dbname)
DATABASE_URL=postgresql://saouti:saouti_local_secret@localhost:5432/saouti

# Redis connection string for BullMQ queue and worker heartbeat
REDIS_URL=redis://localhost:6379

# Master 32-byte hexadecimal key for encrypting user credentials (generate via: openssl rand -hex 32)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session secret string (minimum 32 characters)
SESSION_SECRET=local_development_session_secret_key_minimum_32_characters

# Application HTTP server listening port
PORT=3000

# Runtime environment (development | test | production)
NODE_ENV=development

# Structured logging level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info
